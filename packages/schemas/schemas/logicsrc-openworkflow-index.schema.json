{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.logicsrc.com/logicsrc-openworkflow-index.schema.json",
  "title": "OpenWorkflow index",
  "description": "The list of workflow files a publisher serves at /.well-known/openworkflow.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "version", "workflows"],
  "properties": {
    "type": { "const": "logicsrc.openworkflow-index" },
    "version": { "const": "0.1" },
    "publisher": { "type": "string", "format": "uri", "pattern": "^https://" },
    "updated": { "type": "string", "format": "date-time" },
    "workflows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "id", "title"],
        "properties": {
          "url": { "type": "string", "format": "uri", "pattern": "^https://" },
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 200 },
          "tasks": { "type": "integer", "minimum": 1 },
          "updated": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
