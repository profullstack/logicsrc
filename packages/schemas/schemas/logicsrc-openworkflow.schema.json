{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.logicsrc.com/logicsrc-openworkflow.schema.json",
  "title": "OpenWorkflow",
  "description": "A named collection of OpenTasks, inline or referenced by URL and digest, run in sequence or in any order that respects `after`.",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "version", "id", "title", "order", "tasks"],
  "properties": {
    "type": { "const": "logicsrc.openworkflow" },
    "version": { "const": "0.1" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "description": { "type": "string", "maxLength": 4000 },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" }
      }
    },
    "updated": { "type": "string", "format": "date-time" },
    "order": { "enum": ["sequence", "any"] },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["task"],
            "properties": {
              "task": { "$ref": "https://schemas.logicsrc.com/logicsrc-opentask.schema.json" },
              "after": { "$ref": "#/$defs/after" },
              "optional": { "type": "boolean" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["url", "sha256", "id", "title"],
            "properties": {
              "url": { "type": "string", "format": "uri", "pattern": "^https://" },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
              "title": { "type": "string", "minLength": 1, "maxLength": 200 },
              "after": { "$ref": "#/$defs/after" },
              "optional": { "type": "boolean" }
            }
          }
        ]
      }
    },
    "license": { "type": "string", "maxLength": 100 }
  },
  "$defs": {
    "after": { "type": "array", "uniqueItems": true, "maxItems": 200, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" } }
  }
}
