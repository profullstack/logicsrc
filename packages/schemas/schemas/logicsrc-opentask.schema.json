{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.logicsrc.com/logicsrc-opentask.schema.json",
  "title": "OpenTask",
  "description": "One task a person does on a computer, written down as meaning (goal, parameters, semantic steps, stop conditions, approvals) so an agent can do it again. Never coordinates, never typed values.",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "version", "id", "title", "goal", "apps", "steps", "stop_conditions", "approvals", "success", "source", "status"],
  "properties": {
    "type": { "const": "logicsrc.opentask" },
    "version": { "const": "0.1" },
    "id": { "$ref": "#/$defs/slug" },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "goal": { "type": "string", "minLength": 1, "maxLength": 500 },
    "explanation": { "type": "string", "maxLength": 4000 },
    "apps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "kind"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 200 },
          "kind": { "enum": ["desktop", "browser", "terminal", "web"] },
          "url": { "type": "string", "format": "uri", "pattern": "^https?://" }
        }
      }
    },
    "parameters": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "sensitivity"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
          "description": { "type": "string", "maxLength": 500 },
          "sensitivity": { "enum": ["public", "personal", "secret"] },
          "example": { "type": "string", "maxLength": 200 }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["n", "action", "evidence"],
        "properties": {
          "n": { "type": "integer", "minimum": 1 },
          "action": { "enum": ["focus", "open", "click", "type", "key", "scroll", "drag", "wait", "observe", "other"] },
          "app": { "type": "string", "minLength": 1, "maxLength": 200 },
          "window": { "type": "string", "maxLength": 400 },
          "target": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "role": { "type": "string", "maxLength": 100 },
              "name": { "type": "string", "maxLength": 200 }
            }
          },
          "keys": { "type": "array", "minItems": 1, "maxItems": 10, "items": { "type": "string", "minLength": 1, "maxLength": 40 } },
          "text": { "type": "string", "pattern": "^\\{\\{[a-z][a-z0-9_]{0,63}\\}\\}$" },
          "evidence": { "enum": ["observed", "inferred"] },
          "recorded": { "type": "string", "pattern": "^[0-9]{1,6}(-[0-9]{1,6})?$" },
          "note": { "type": "string", "maxLength": 500 }
        }
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile"],
      "properties": {
        "profile": { "enum": ["visual-review", "semantic", "full"] },
        "window_titles": { "enum": ["kept", "removed"] },
        "gaps": { "type": "array", "uniqueItems": true, "maxItems": 20, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,39}$" } }
      }
    },
    "stop_conditions": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 300 } },
    "approvals": { "type": "array", "maxItems": 20, "items": { "type": "string", "pattern": "^[Bb]efore ", "maxLength": 300 } },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check", "evidence"],
      "properties": {
        "check": { "type": "string", "minLength": 1, "maxLength": 500 },
        "evidence": { "enum": ["screen", "artifact", "human_assertion"] }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reviewed"],
      "properties": {
        "kind": { "enum": ["demonstration", "authored"] },
        "recorder": { "type": "string", "maxLength": 100 },
        "episode": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,100}$" },
        "recorded": { "type": "string", "format": "date-time" },
        "reviewed": { "type": "boolean" },
        "outcome": { "enum": ["success", "partial", "failure"] }
      }
    },
    "status": { "enum": ["untested", "passed", "failed"] },
    "runners": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "url", "sha256"],
        "properties": {
          "kind": { "enum": ["moshscript", "mcp", "script", "other"] },
          "url": { "type": "string", "format": "uri", "pattern": "^https://" },
          "sha256": { "$ref": "#/$defs/sha256" },
          "command": { "type": "string", "maxLength": 300 }
        }
      }
    },
    "license": { "type": "string", "maxLength": 100 }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
